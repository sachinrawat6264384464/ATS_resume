# ==============================================================================
# ResumeIQ - Environment Configuration Template
# ==============================================================================

# Database
# Local SQLite default for instant dev, or PostgreSQL: postgresql://postgres:postgres@localhost:5432/resumeiq
DATABASE_URL=sqlite:///./resumeiq.db

# Redis & Cache (Optional for dev fallback)
REDIS_URL=redis://localhost:6379/0

# Application URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# AI & Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional Ollama Local LLM Integration (System operates 100% deterministically if unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
ENABLE_OLLAMA=false

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
FILE_RETENTION_HOURS=24
RATE_LIMIT_PER_MINUTE=60

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

